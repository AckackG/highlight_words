{
  "manifest_version": 3,
  "name": "Vocabulary Highlighter & Notebook",
  "version": "2.0",
  "description": "高亮生词、划词翻译、语境记忆与生词本管理",
  "permissions": [
    "storage",
    "contextMenus",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.openai.com/*",
    "https://freeopenrouter.turfia.ggff.net/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Vocabulary Notebook",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": [
        "utils/helpers.js",           
        "utils/highlight-colors.js",
        "utils/selection-validator.js",
        "utils/context-extractor.js",
        "utils/notebook-api.js",
        "ui/tooltip-controller.js",
        "content/selection-ui.js",
        "content/content.js"
      ],
      "css": ["content/styles.css"]
    }
  ],
  "options_page": "dashboard/index.html",
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}